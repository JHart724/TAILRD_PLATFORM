# === REQUIRED FOR PHASE 1 ===
NODE_ENV=production
DATABASE_URL=postgresql://user:password@host:5432/tailrd_platform
REDIS_URL=redis://host:6379
JWT_SECRET=  # Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_UPLOADS=tailrd-prod-uploads

# Frontend
FRONTEND_URL=https://app.tailrd.com
CORS_ORIGINS=https://app.tailrd.com

# === OPTIONAL (Phase 2) ===
REDOX_CLIENT_ID=
REDOX_CLIENT_SECRET=
REDOX_WEBHOOK_SECRET=
SES_FROM_ADDRESS=noreply@tailrd.com
PHI_ENCRYPTION_KEY=

# Layer-3 BAA guard mode: off | audit | strict.
# UNSET currently resolves to 'audit'. From AUDIT-214 PR 2 onward, UNSET becomes a hard
# startup error (fail-fast), so this must be set explicitly. Local/dev default: audit.
# Production runs 'strict' (set on the ECS task-def, not from this file).
BAA_GUARD_MODE=audit

# === DEVELOPMENT ONLY ===
DEMO_MODE=true
LOG_INVITE_URL=true
